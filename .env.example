# ─── Шаблон секретов AI Automation Studio ───────────────────────────
# Скопируй в .env и заполни реальными значениями. .env в .gitignore.
#
#   cp .env.example .env
#
# Агенты (Claude Code, Codex) читают .env из корня репозитория.

# ─── Bubbles (usebubbles.com) — записи встреч, транскрипты ──────────
# MCP-эндпоинт (OAuth, подключён на уровне аккаунта claude.ai):
#   https://api.usebubbles.com/mcp
# Для прямых HTTP-вызовов нужен personal access token из настроек Bubbles.
BUBBLES_API_TOKEN=
BUBBLES_API_BASE=https://api.usebubbles.com
BUBBLES_TEAM_ID=239e55d7-4108-4b28-aa0a-bb24ecbb9733

# ─── Telegram WorkBK ────────────────────────────────────────────────
# Тот же токен, что в /Users/bk/.config/boris-os/workbk.env
WORKBK_TELEGRAM_TOKEN=
WORKBK_CHAT_ID=2904366
